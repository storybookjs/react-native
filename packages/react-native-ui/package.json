{
  "name": "@storybook/react-native-ui",
  "version": "11.0.0-next.1",
  "description": "ui components for react native storybook",
  "keywords": [
    "react",
    "react-native",
    "storybook"
  ],
  "homepage": "https://storybook.js.org/",
  "bugs": {
    "url": "https://github.com/storybookjs/react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/react-native.git",
    "directory": "packages/react-native-ui"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "react-native": "src/index.tsx",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "src/**/*",
    "!babel.config.js",
    "!jest.config.js",
    "!jest.setup.js",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "test": "jest",
    "test:ci": "jest"
  },
  "dependencies": {
    "@gorhom/portal": "^1.0.14",
    "@nozbe/microfuzz": "^1.0.0",
    "@storybook/react": "^11.0.0-beta.0",
    "@storybook/react-native-theming": "^11.0.0-next.1",
    "@storybook/react-native-ui-common": "^11.0.0-next.1",
    "polished": "^4.3.1"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.0.0-beta.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^30.5.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-worklets": "0.13.0",
    "storybook": "^11.0.0-beta.0",
    "tsdown": "^0.22.12",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=4",
    "react": "*",
    "react-native": ">=0.57.0",
    "react-native-gesture-handler": ">=2",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": "*",
    "react-native-svg": ">=14",
    "storybook": "^11.0.0-beta.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
