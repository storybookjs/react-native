{
  "name": "@storybook/react-native",
  "version": "10.0.0-beta.9",
  "description": "A better way to develop React Native Components for your app",
  "keywords": [
    "react",
    "react-native",
    "storybook"
  ],
  "homepage": "https://storybook.js.org/",
  "bugs": {
    "url": "https://github.com/storybookjs/react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/react-native.git",
    "directory": "packages/react-native"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "sb-rn-get-stories": "./bin/get-stories.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./metro/withStorybook": "./dist/metro/withStorybook.js",
    "./preview": "./dist/preview.js",
    "./scripts/generate": "./scripts/generate.js",
    "./preset": "./preset.js",
    "./stub": "./dist/stub.js"
  },
  "files": [
    "bin/**/*",
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "scripts/*",
    "template/**/*",
    "metro/**/*"
  ],
  "scripts": {
    "dev": "npx --yes tsx buildscripts/gendtsdev.ts && tsup --watch",
    "prepare": "rm -rf dist/ && tsup",
    "test": "jest && yarn test:generate",
    "test:ci": "jest && yarn test:generate",
    "test:generate": "node --test scripts/generate.test.js",
    "test:generate:update": "node --test --test-update-snapshots scripts/generate.test.js"
  },
  "dependencies": {
    "@storybook/global": "^5.0.0",
    "@storybook/react": "10.0.0-rc.1",
    "@storybook/react-native-theming": "^10.0.0-beta.9",
    "@storybook/react-native-ui": "^10.0.0-beta.9",
    "@storybook/react-native-ui-common": "^10.0.0-beta.9",
    "commander": "^8.2.0",
    "dedent": "^1.5.1",
    "deepmerge": "^4.3.0",
    "esbuild-register": "^3.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "setimmediate": "^1.0.5",
    "type-fest": "~2.19",
    "util": "^0.12.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@types/jest": "^29.4.3",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^12.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.12",
    "jotai": "^2.6.2",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "storybook": "10.0.0-rc.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "universal-test-renderer": "^0.6.0"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=4",
    "react": "*",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2",
    "react-native-reanimated": ">=2",
    "react-native-safe-area-context": "*",
    "storybook": ">=10 || 10.0.0-beta.0 || ^10"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
