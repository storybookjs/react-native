{
  "name": "repack-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --no-packager",
    "bundle:android": "react-native webpack-bundle --platform android --entry-file index.js --dev=false --bundle-output build/output/android/index.android.bundle --assets-dest build/output/android/res",
    "bundle:ios": "react-native webpack-bundle --platform ios --entry-file index.js --dev=false --bundle-output build/output/ios/main.jsbundle --assets-dest build/output/ios",
    "ios": "STORYBOOK_ENABLED=true react-native run-ios --no-packager",
    "lint": "eslint .",
    "start": "react-native webpack-start",
    "storybook": "STORYBOOK_ENABLED=true react-native webpack-start",
    "test": "jest --passWithNoTests",
    "pods": "(cd ios && bundle install && (bundle exec pod install || bundle exec pod update))",
    "pods:update": "(cd ios && bundle install && bundle exec pod update)"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/new-app-screen": "0.85.3",
    "@storybook/addon-ondevice-actions": "^10.4.7",
    "@storybook/addon-ondevice-backgrounds": "^10.4.7",
    "@storybook/addon-ondevice-controls": "^10.4.7",
    "@storybook/addon-ondevice-notes": "^10.4.7",
    "@storybook/react": "10.5.0-beta.2",
    "@storybook/react-native": "workspace:^",
    "@storybook/react-native-ui-lite": "workspace:^",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "storybook": "10.5.0-beta.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@callstack/repack": "^5.2.5",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "^0.85.0",
    "@react-native/eslint-config": "^0.85.3",
    "@react-native/metro-config": "^0.85.0",
    "@react-native/typescript-config": "^0.85.3",
    "@rnx-kit/metro-config": "^2.2.4",
    "@rspack/core": "^2.0.8",
    "@swc/helpers": "^0.5.23",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "react-native-test-app": "^5.3.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
