{
  "name": "@storybook/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:types": "tsc --noEmit",
    "test": "node --test scripts/generate.test.ts scripts/docgen.test.ts scripts/bundleEntrySwap.test.ts",
    "test:ci": "node --test scripts/generate.test.ts scripts/docgen.test.ts scripts/bundleEntrySwap.test.ts",
    "test:update": "node --test --test-update-snapshots scripts/generate.test.ts scripts/docgen.test.ts scripts/bundleEntrySwap.test.ts"
  },
  "dependencies": {
    "@storybook/addon-ondevice-actions": "workspace:*",
    "@storybook/addon-ondevice-backgrounds": "workspace:*",
    "@storybook/addon-ondevice-controls": "workspace:*",
    "@storybook/addon-ondevice-notes": "workspace:*",
    "@storybook/react-native": "workspace:*"
  },
  "devDependencies": {
    "metro": "0.84.6",
    "metro-babel-transformer": "0.84.6"
  }
}
